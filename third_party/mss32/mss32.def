; Import definitions for the Miles Sound System (mss32.dll) as the game uses them.
; mss32.dll exports stdcall-decorated names (_AIL_x@N); '==' sets that import name.
LIBRARY mss32.dll
EXPORTS
    AIL_stream_ms_position@12 == _AIL_stream_ms_position@12
    AIL_stream_status@4 == _AIL_stream_status@4
    AIL_end_sample@4 == _AIL_end_sample@4
    AIL_resume_sample@4 == _AIL_resume_sample@4
    AIL_start_sample@4 == _AIL_start_sample@4
    AIL_init_sample@4 == _AIL_init_sample@4
    AIL_get_timer_highest_delay@0 == _AIL_get_timer_highest_delay@0
    AIL_allocate_sample_handle@4 == _AIL_allocate_sample_handle@4
    AIL_set_preference@8 == _AIL_set_preference@8
    AIL_digital_handle_reacquire@4 == _AIL_digital_handle_reacquire@4
    AIL_digital_handle_release@4 == _AIL_digital_handle_release@4
    AIL_waveOutClose@4 == _AIL_waveOutClose@4
    AIL_waveOutOpen@16 == _AIL_waveOutOpen@16
    AIL_get_preference@4 == _AIL_get_preference@4
    AIL_set_digital_master_volume@8 == _AIL_set_digital_master_volume@8
    AIL_shutdown@0 == _AIL_shutdown@0
    AIL_startup@0 == _AIL_startup@0
    AIL_last_error@0 == _AIL_last_error@0
    AIL_set_stream_ms_position@8 == _AIL_set_stream_ms_position@8
    AIL_set_stream_loop_count@8 == _AIL_set_stream_loop_count@8
    AIL_pause_stream@8 == _AIL_pause_stream@8
    AIL_set_stream_volume@8 == _AIL_set_stream_volume@8
    AIL_open_stream@12 == _AIL_open_stream@12
    AIL_start_stream@4 == _AIL_start_stream@4
    AIL_close_stream@4 == _AIL_close_stream@4
    AIL_sample_status@4 == _AIL_sample_status@4
    AIL_set_sample_pan@8 == _AIL_set_sample_pan@8
    AIL_set_sample_loop_count@8 == _AIL_set_sample_loop_count@8
    AIL_set_sample_volume@8 == _AIL_set_sample_volume@8
    AIL_release_sample_handle@4 == _AIL_release_sample_handle@4
    AIL_set_named_sample_file@20 == _AIL_set_named_sample_file@20
