{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw-i686.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "plain",
      "inherits": "base",
      "displayName": "the game as the original builds it",
      "binaryDir": "${sourceDir}/build-cmake/plain"
    },
    {
      "name": "play",
      "inherits": "base",
      "displayName": "manual testing: 16-bit back buffer in a window, frame dumps",
      "binaryDir": "${sourceDir}/build-cmake/play",
      "cacheVariables": {
        "REGUILDX_FIX_16BPP": "ON",
        "REGUILDX_FRAME_DUMP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "plain",
      "configurePreset": "plain"
    },
    {
      "name": "play",
      "configurePreset": "play"
    }
  ]
}
